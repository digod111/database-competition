# seekdb（Docker 服务端模式，兼容 MySQL 协议）
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=qoder_app

# PowerContext 本地 Server
POWERCONTEXT_URL=http://127.0.0.1:18081
POWERCONTEXT_HOME=.powercontext
POWERCONTEXT_SCOPE_PREFIX=wengu

# Web 应用
WENGU_HOST=127.0.0.1
WENGU_PORT=8000
WENGU_DEFAULT_USER=demo

# 以下路径可选，默认在项目目录内
# WENGU_DOCS_DIR=docs
# WENGU_RUNTIME_DIR=.runtime
# WENGU_SEED_DIR=seed
