# seekdb：默认使用 Docker server 模式
SEEKDB_MODE=server
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=test
# 可选：嵌入式模式的数据目录（SEEKDB_MODE=embedded 时使用）
SEEKDB_DATA_DIR=.seekdb_data

# PowerContext 本地 Server
POWERCONTEXT_URL=http://127.0.0.1:18080
POWERCONTEXT_HOME=.powercontext
POWERCONTEXT_SCOPE_TITLE=minimax-sdd-context-demo
POWERCONTEXT_SCOPE_KEY=minimax-sdd-context-demo-v1

# MiniMax Token Plan：不要把真实 Key 提交到仓库
MINIMAX_API_KEY=
# 中国区：https://api.minimaxi.com/v1；国际区：https://api.minimax.io/v1
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_TIMEOUT=180

# 可选：覆盖默认路径
# SDD_WORKSPACE=workspace/taskboard
# SDD_BEFORE=workspace/taskboard_before
# SDD_TASKS=tasks
# SDD_DOCS=docs
# SDD_ARTIFACTS=artifacts
# SDD_RUNTIME=.runtime
