# Dify 1.19.0 deployment inputs (copy to deploy/dify/.env)
# Keep COMPOSE_PROFILES and VECTOR_STORE aligned.
COMPOSE_PROFILES=postgresql,pgvector
VECTOR_STORE=pgvector

# Required by the bundled agent local sandbox.
# Generate with: openssl rand -hex 32
DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Dify HTTP Request nodes must reach host.docker.internal:8010 and :18082.
# The bundled SSRF proxy denies private addresses by default.
SSRF_PROXY_ALLOW_PRIVATE_DOMAINS=host.docker.internal
SSRF_PROXY_ALLOW_PRIVATE_IPS=

# Optional: faster plugin dependency installation in mainland China.
PIP_MIRROR_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# If port 80 is occupied, change this and use the same port in the browser.
EXPOSE_NGINX_PORT=80
